{
    "name": "milpa/web-search",
    "description": "A governed web:search capability for Milpa apps — read-only locally, but the query leaves the machine (Externality::ThirdParty), so the egress gate governs it.",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Rodrigo Vicente - TeamX Agency",
            "homepage": "https://teamx.agency"
        }
    ],
    "require": {
        "php": ">=8.3",
        "milpa/command": ">=0.5 <1.0"
    },
    "autoload": {
        "psr-4": {
            "Milpa\\WebSearch\\": "src/"
        }
    },
    "extra": {
        "milpa": {
            "capability": {
                "id": "web-search",
                "title": "Search the web via a LAN SearXNG — governed as a third-party egress",
                "unlocks": [
                    "web:search"
                ],
                "provides": [],
                "briefing": "This app can search the web (web:search) — read-only locally, but the query leaves the machine, so the gate asks before the crossing.",
                "operations": [
                    "Milpa\\WebSearch\\WebSearchOperations"
                ]
            }
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpdoc-parser": "^2.3",
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Milpa\\WebSearch\\Tests\\": "tests/"
        }
    },
    "homepage": "https://github.com/getmilpa/web-search"
}
